[Pack "slav"]
[Side "black"]
[NameDe "Slawisch"]
[NameEn "Slav Defence"]
[BlurbDe "Schwarz gegen 1.d4: …d5 und …c6, der Läufer geht nach f5. Gleiche Idee wie im Caro-Kann."]
[BlurbEn "Black against 1.d4: …d5 and …c6, the bishop goes to f5. Same idea as the Caro-Kann."]
[Level1De "Die Grundidee"]
[Level1En "The main idea"]

1. d4 d5
2. c4
  (2. Nf3 {level 6: de: Ohne 2.c4 || en: Without 2.c4} Nf6 3. c4
      (3. Bf4 Bf5 4. e3 e6 5. c4 c6 6. Nc3 Nbd7)
      (3. e3 Bf5 4. Bd3 Bxd3 5. Qxd3 e6)
    3... c6)
  (2. Bf4 {level 6} Nf6 3. e3 Bf5 4. Nf3 e6 5. c4 c6)
  (2. e3 {level 6} Nf6 3. Nf3 Bf5)
  (2. Nc3 {level 6} Nf6 3. Bg5 (3. Bf4 Bf5 4. e3 e6) 3... Nbd7 4. Nf3 h6)
2... c6 {de: Deckt d5 mit einem Bauern. Der Läufer c8 bleibt frei für f5 oder g4. || en: Supports d5 with a pawn. The c8 bishop stays free for f5 or g4.}
3. Nf3
  (3. Nc3 {level 5: de: Andere Züge von Weiss || en: Other White tries} Nf6 4. e3
      (4. Nf3)
      (4. Bg5 Ne4 5. Bf4 Nxc3 6. bxc3 dxc4)
      (4. cxd5 cxd5 5. Bf4 Nc6)
    4... Bf5 5. Nf3 e6)
  (3. cxd5 {level 4: de: Abtausch || en: Exchange} cxd5 {de: Abtausch: Schwarz spiegelt einfach und entwickelt. || en: Exchange: Black mirrors and develops.}
    4. Nc3
      (4. Nf3 Nf6 5. Nc3 Nc6 6. Bf4 Bf5)
      (4. Bf4 Nc6 5. e3 Nf6 6. Nc3 Bf5)
    4... Nf6 5. Bf4 Nc6 6. e3 Bf5 7. Nf3 e6)
  (3. e3 {level 3} Nf6 4. Nf3 (4. Nc3 Bf5) 4... Bf5)
3... Nf6 4. Nc3
  (4. e3 {level 3: de: Ruhige Aufbauten || en: Quiet setups} Bf5 {de: Der Läufer kommt raus, bevor …e6 ihn einsperrt. Das ist die ganze Idee. || en: The bishop gets out before …e6 locks it in. That is the whole idea.}
    5. Nc3
      (5. Bd3 Bxd3 6. Qxd3 e6 7. Nc3 Nbd7 8. O-O Bd6)
      (5. cxd5 cxd5 6. Qb3 (6. Nc3 e6) 6... Qb6)
      (5. Qb3 Qb6)
    5... e6 6. Nh4 Bg6 7. Nxg6 hxg6 {de: Weiss hat das Läuferpaar, Schwarz die halboffene h-Linie. || en: White has the bishop pair, Black gets the half-open h-file.}
    8. Bd3 Nbd7)
  (4. Qc2 {level 3} dxc4 5. Qxc4 Bf5)
  (4. cxd5 {level 4} cxd5 5. Nc3 Nc6 6. Bf4 Bf5 7. e3 e6)
  (4. g3 {level 3} Bf5 5. Bg2 e6 6. O-O Nbd7)
4... dxc4 {de: Schwarz nimmt den Bauern und droht, ihn mit …b5 zu halten. Weiss verhindert das mit a4. || en: Black takes the pawn and threatens to keep it with …b5. White stops that with a4.}
5. a4 {level 2: de: Hauptvariante mit a4 und …Lf5 || en: Main line with a4 and …Bf5}
  (5. e3 {level 5} b5 6. a4 b4 7. Na2 e6)
  (5. e4 {level 5} b5 6. e5 Nd5 7. a4 e6)
5... Bf5 6. e3
  (6. Ne5 Nbd7 7. Nxc4 Qc7 8. g3 e5)
  (6. Nh4 Bc8 7. e3 e5)
6... e6 7. Bxc4 Bb4 8. O-O O-O {de: Hauptstellung des Slawen: gleich, gesund, gut entwickelt. || en: The main Slav position: equal, healthy and well developed.} *
